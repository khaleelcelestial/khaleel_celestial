# Copy this to .env and fill in your API keys.
#
# Every key below is one entry in core/model_config.py's CREDENTIAL_POOL.
# You don't need to fill in all 8 - whatever's set gets used; each skill's
# fallback chain automatically walks through every OTHER configured
# credential (all accounts, both providers) before giving up, so a rate
# limit on one key just moves to the next one instead of failing the call.

# ==============================================================================
# AZURE OPENAI (gpt-5.4-mini) - primary for every skill; everything else
# below is fallback if this is unreachable
# ==============================================================================
AZURE_OPENAI_API_KEY=your-azure-ai-foundry-api-key-here

# ==============================================================================
# ACCOUNT 1
# ==============================================================================
GROQ_API_KEY_A1=your-groq-api-key-for-account-1-here
MISTRAL_API_KEY_A1=your-mistral-api-key-for-account-1-here

# ==============================================================================
# ACCOUNT 2
# ==============================================================================
GROQ_API_KEY_A2=your-groq-api-key-for-account-2-here
MISTRAL_API_KEY_A2=your-mistral-api-key-for-account-2-here

# ==============================================================================
# ACCOUNT 3
# ==============================================================================
GROQ_API_KEY_A3=your-groq-api-key-for-account-3-here
MISTRAL_API_KEY_A3=your-mistral-api-key-for-account-3-here

# ==============================================================================
# ACCOUNT 4
# ==============================================================================
GROQ_API_KEY_A4=your-groq-api-key-for-account-4-here
MISTRAL_API_KEY_A4=your-mistral-api-key-for-account-4-here

# ==============================================================================
# OPTIONAL EXTRAS
# ==============================================================================

# Anthropic/Claude key - not wired into CREDENTIAL_POOL by default (see the
# "HOW TO ADD A NEW PROVIDER" note in core/model_config.py to add it).
ANTHROPIC_API_KEY=your-anthropic-api-key-here


# ==============================================================================
# POSTGRESQL - login credentials reused for every generated project's db
# service (each project still gets its own separate database + ports,
# auto-assigned - see output/.port_allocations.json - not set here)
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me


# ==============================================================================
# NOTES
# ==============================================================================
#
# MINIMUM SETUP: at least one account with BOTH its Groq and Mistral key set
# (e.g. just GROQ_API_KEY_A1 + MISTRAL_API_KEY_A1). More accounts just add
# more fallback depth - nothing else needs to change to use them once the
# keys are in this file.
#
# ADDING A 5TH+ ACCOUNT: add its two keys here, then add the matching
# CREDENTIAL_POOL entries in core/model_config.py - see the "HOW TO ADD A
# NEW ACCOUNT" note there.
#
# GET API KEYS:
# -------------
# Groq: https://console.groq.com/keys
# Mistral: https://console.mistral.ai/
# Anthropic: https://console.anthropic.com/
